# =============================================================================
# MiniCPM-V 子目录的忽略规则
#   原则：**只收代码和小体积文本**。模型权重、虚拟环境、原始素材、评测出图
#   都在各人本地，不进仓库（下面写明怎么自己弄）。
# =============================================================================

# ── 模型权重（687 MB，谁用谁自己下）─────────────────────────
.hf/
models/
*.safetensors
*.gguf

# ── 虚拟环境 ───────────────────────────────────────────────
venv_det/
venv/
.venv/
torchinductor_*/

# ── 原始素材 / 大媒体（本地保存）───────────────────────────
data/
old/
vendor/
*.mp4
*.avi
*.mov

# ── 评测产物（只保留 eval/*.py 和 eval/results/）───────────
eval/figures/
eval/demo_out/
eval/window_range_figs/
eval/center_figs/
eval/lat_crop_figs/
eval/plans_figs/
eval/vlm_out/

# ── 通用垃圾 ───────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.log
*.bak
*.bak_*
.vscode/
.DS_Store
Thumbs.db
